# PostgreSQL (profile: postgres)
DB_URL=jdbc:postgresql://localhost:5432/autorrent
DB_USER=autorrent
DB_PASSWORD=autorrent

# JWT (must be at least 32 bytes / 256 bits for HS256)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_SECONDS=86400

# Seed demo data on empty database
APP_SEED_ENABLED=true
